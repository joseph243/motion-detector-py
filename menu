from telegram import Update, ReplyKeyboardMarkup, KeyboardButton
from telegram.ext import Application, CommandHandler, MessageHandler, filters, ContextTypes

# 1. Define the persistent layout grid with emojis
KEYBOARD_LAYOUT = [
    [KeyboardButton("🌙 Sleep"), KeyboardButton("▶️ Start")],
    [KeyboardButton("📸 Snapshot"), KeyboardButton("📊 Status")]
]

# resize_keyboard=True keeps the buttons compact at the bottom of the screen
REPLY_KEYBOARD = ReplyKeyboardMarkup(KEYBOARD_LAYOUT, resize_keyboard=True)

async def send_menu(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Sends or refreshes the persistent control panel in Telegram."""
    await update.message.reply_text(
        "⚙️ **Homebot Control Panel**",
        reply_markup=REPLY_KEYBOARD,
        parse_mode="Markdown"
    )

async def handle_button_press(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Parses incoming text from the persistent keyboard buttons."""
    command = update.message.text

    if command == "🌙 Sleep":
        # Insert your sleep routine / low-power state logic here
        await update.message.reply_text("🌙 System entering sleep mode.")

    elif command == "▶️ Start":
        # Insert your startup / active monitoring logic here
        await update.message.reply_text("▶️ System active and monitoring.")

    elif command == "📸 Snapshot":
        # Insert your camera capture code here
        await update.message.reply_text("📸 Taking camera snapshot...")

    elif command == "📊 Status":
        # Insert your health check / uptime check code here
        await update.message.reply_text("📊 Status: All systems operational.")

def main():
    # Replace with your actual bot token
    app = Application.builder().token("YOUR_TELEGRAM_BOT_TOKEN").build()

    # Register handlers
    app.add_handler(CommandHandler("start", send_menu))
    app.add_handler(CommandHandler("menu", send_menu))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_button_press))

    print("Homebot listening...")
    app.run_polling()

if __name__ == "__main__":
    main()
